# --- Eszközök / függőségek ---
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
build/
# A dist/ a publikált (aláírandó) katalógus, ezért verziókezelt: NEM zárjuk ki.

# --- Aláírókulcsok, titkok (soha ne kerüljenek a repóba; csak a NYILVÁNOS kulcs commitolható) ---
*.key
*.sec
*.pem
*.p12
*.pfx
*.jks
*.keystore
secrets/
.env
